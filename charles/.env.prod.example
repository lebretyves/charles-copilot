# CHARLES - production-like example environment
# Copy to .env.prod and pair it with docker-compose.prod.yml

APP_ENV=prod

# Public URLs / host policy
FRONTEND_PUBLIC_URL=https://charles.example.com
CORS_ORIGINS=https://charles.example.com
TRUSTED_HOSTS=charles.example.com,localhost,127.0.0.1

# Auth and secrets
JWT_SECRET_FILE=/run/secrets/jwt_secret
CHARLES_DEFAULT_PASSWORD_FILE=/run/secrets/default_password
CHARLES_ADMIN_PASSWORD_FILE=/run/secrets/admin_password
AUTH_TOKEN_EXPIRY_HOURS=12

# Database
DATABASE_URL=postgresql+asyncpg://charles:replace-with-strong-password@postgres:5432/charles
POSTGRES_PASSWORD=replace-with-strong-password

# Redis
REDIS_URL=redis://redis:6379/0

# MQTT
MQTT_BROKER=mosquitto
MQTT_PORT=1883
MQTT_USER=charles
MQTT_PASSWORD_FILE=/run/secrets/mqtt_password

# Knowledge base and dataset
KB_PATH=/kb
VITALDB_METADATA=/data/vitaldb/clinical_metadata.csv
VITALDB_CASES=/data/vitaldb/cases
VITALDB_WAVEFORMS=/data/vitaldb/waveforms

# LLM
LLM_PROVIDER=ollama
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=meditron:7b
OPENAI_API_KEY_FILE=
OPENAI_MODEL=gpt-4o-mini
LLM_ANALYSIS_TIMEOUT_S=45

# Logging / ops
AUDIT_LOG_ENABLED=true
