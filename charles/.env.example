# CHARLES - Example environment file for the waveform MVP
# Copy to .env and adapt before sharing the stack.

# Runtime mode
APP_ENV=dev

# Auth
JWT_SECRET=change-me-with-openssl-rand-hex-32
JWT_SECRET_FILE=
CHARLES_DEFAULT_PASSWORD=charles2026
CHARLES_DEFAULT_PASSWORD_FILE=
CHARLES_ADMIN_PASSWORD=admin2026
CHARLES_ADMIN_PASSWORD_FILE=
AUTH_TOKEN_EXPIRY_HOURS=24

# Database
DATABASE_URL=postgresql+asyncpg://charles:charles_dev_2026@postgres:5432/charles
DATABASE_URL_FILE=
POSTGRES_PASSWORD=charles_dev_2026

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_URL_FILE=

# MQTT
MQTT_BROKER=mosquitto
MQTT_PORT=1883
MQTT_USER=charles
MQTT_PASSWORD=change-me-mqtt-password
MQTT_PASSWORD_FILE=

# Knowledge base
KB_PATH=/kb

# VitalDB open dataset
VITALDB_METADATA=/data/vitaldb/clinical_metadata.csv
VITALDB_CASES=/data/vitaldb/cases
VITALDB_WAVEFORMS=/data/vitaldb/waveforms

# Frontend/API
CORS_ORIGINS=https://localhost:3000,https://127.0.0.1:3000,http://localhost:3080,http://127.0.0.1:3080,http://localhost:5173
TRUSTED_HOSTS=localhost,127.0.0.1
FRONTEND_PUBLIC_URL=https://localhost:3000

# LLM
LLM_PROVIDER=ollama
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=meditron:7b
OPENAI_API_KEY=
OPENAI_API_KEY_FILE=
OPENAI_MODEL=gpt-4o-mini
LLM_ANALYSIS_TIMEOUT_S=45

# Ops
AUDIT_LOG_ENABLED=true
