# ═══════════════════════════════════════════════════════════════
# CHARLES — Exemple de configuration (.env)
# Copier ce fichier en .env et adapter les valeurs à votre environnement.
# NE JAMAIS commettre le vrai .env dans Git.
# ═══════════════════════════════════════════════════════════════

# ── Authentification JWT ───────────────────────────────────────
# Clé secrète HMAC-SHA256. Générer avec : openssl rand -hex 32
JWT_SECRET=changez-moi-en-production-openssl-rand-hex-32

# ── PostgreSQL ─────────────────────────────────────────────────
# Format : postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://charles:charles_dev_2026@postgres:5432/charles
POSTGRES_PASSWORD=charles_dev_2026

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── MQTT (Mosquitto) ──────────────────────────────────────────
MQTT_BROKER=mosquitto
MQTT_PORT=1883

# ── Knowledge Base ────────────────────────────────────────────
KB_PATH=kb

# ── VitalDB (données de simulation) ──────────────────────────
VITALDB_METADATA=/data/vitaldb/clinical_metadata.csv
VITALDB_CASES=/data/vitaldb/cases

# ── CORS ─────────────────────────────────────────────────────
# Origines autorisées, séparées par virgule (pas d'espaces)
CORS_ORIGINS=https://charles.monhote.com

# ── LLM Provider ─────────────────────────────────────────────
# Valeurs possibles : ollama | openai
LLM_PROVIDER=ollama

# Ollama (si LLM_PROVIDER=ollama)
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=meditron:7b

# OpenAI (si LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
